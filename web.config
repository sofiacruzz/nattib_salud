<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Asegurar que las rutas de la API no se reescriban incorrectamente -->
        <rule name="API Routes" stopProcessing="true">
          <match url="^(auth|medico)/.*" />
          <action type="None" />
        </rule>

        <!-- Si es una solicitud de un archivo estático (CSS, JS, imágenes), no la reescribas -->
        <rule name="Static Files" stopProcessing="true">
          <match url="(.*\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf))$" />
          <action type="None" />
        </rule>

        <!-- Cualquier otra solicitud es redirigida al backend -->
        <rule name="DynamicContent">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
